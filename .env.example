# Copy to .env and fill in. .env is git-ignored.

# ── core-backend ──────────────────────────────────────────────────────────
PORT=8080
# Sign JWTs with a long random value, e.g. `openssl rand -hex 32`.
# Leave it empty and the server generates one per start: convenient locally,
# but every restart invalidates existing logins.
JWT_SECRET=
# Leave empty to run with an in-memory store (no database needed; data is
# lost on restart). Set it to persist accounts and audits.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dai

# Where the backend reaches the other two services.
CRAWLER_SERVICE_BASE=http://127.0.0.1:5001
AI_SERVICE_BASE=http://127.0.0.1:5002

# ── ai-assistant ──────────────────────────────────────────────────────────
# Groq API key (https://console.groq.com/keys). Without it audits still run
# and fall back to rule-based advice; the AI chat returns a clear error.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── crawler-engine ────────────────────────────────────────────────────────
CRAWLER_TIMEOUT=30
# Local development only: allows auditing localhost / private addresses.
# Never enable this on a public deployment (SSRF).
CRAWLER_ALLOW_PRIVATE=0

# ── frontend-ui ───────────────────────────────────────────────────────────
# Leave empty: the frontend calls /api on its own origin, which Vite proxies
# in development and nginx proxies in production.
VITE_API_BASE=
